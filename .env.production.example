MAIL_USERNAME=resend
MAIL_PASSWORD=GANTI_DENGAN_RESEND_SMTP_API_KEY
MAIL_FROM_ADDRESS=no-reply@kotagedejewellery.tech
MAIL_FROM_NAME="${APP_NAME}"

TRAEFIK_HOST=subdomain.kotagedejewellery.tech
TRAEFIK_NETWORK=proxy
TRAEFIK_CERT_RESOLVER=letsencrypt
APP_IMAGE=kgj-lms-academy-app
