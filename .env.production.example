APP_NAME="KGJ Academy"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://lms.kotagedejewellery.tech
APP_LOCALE=id
APP_FALLBACK_LOCALE=id
LOG_CHANNEL=stack
LOG_LEVEL=warning

DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=kgj_academy
DB_USERNAME=kgj
DB_PASSWORD=GANTI_DENGAN_PASSWORD_DATABASE_YANG_KUAT
POSTGRES_VOLUME=kgj-lms-academy_postgres_data

CACHE_STORE=redis
QUEUE_CONNECTION=database
DB_QUEUE_RETRY_AFTER=180
REDIS_HOST=redis
REDIS_CLIENT=predis
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_VOLUME=kgj-lms-academy_redis_data

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

FILESYSTEM_DISK=local
STORAGE_VOLUME=kgj-lms-academy_storage_data
IMPORT_INITIAL_PASSWORD=GANTI_DENGAN_PASSWORD_AWAL_IMPORT_YANG_KUAT

FONNTE_URL=https://api.fonnte.com/send
